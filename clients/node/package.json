{
  "name": "tikovm",
  "version": "0.1.0",
  "description": "TypeScript client for the tikovm hostd API (Firecracker microVM management)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:e2e": "tsc -p tsconfig.e2e.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/test/*.test.js'"
  },
  "keywords": [
    "tikovm",
    "firecracker",
    "microvm",
    "hostd"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0"
  }
}
